# ---------------------------------------------------------------------------
# CollabU environment reference
# ---------------------------------------------------------------------------
# This project is a no-build static PWA, so the browser reads its runtime
# configuration from js/config.js (edit that file with the values below).
# These variables are provided for local tooling, CI, or a future Vite migration.

# Supabase (Project Settings > API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google OAuth (Supabase > Authentication > Providers > Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Site / redirect URLs
SITE_URL=http://localhost:3000
GOOGLE_REDIRECT=http://localhost:3000

# Optional: service role key — NEVER expose in the browser. Server/CLI only.
SUPABASE_SERVICE_ROLE_KEY=